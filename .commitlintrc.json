{
  "_comment": "Commitlint configuration. Repository policy lives in .config/commit-rules.json; its upstream pin and local adaptations are recorded in .config/commit-rules.meta.json. Regenerate the vendored commit-msg hook with the pinned generator after changing policy.",
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "test",
        "chore",
        "ci",
        "build",
        "perf",
        "revert"
      ]
    ],
    "subject-case": [
      0
    ],
    "subject-empty": [
      2,
      "never"
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ],
    "header-max-length": [
      2,
      "always",
      72
    ],
    "body-max-line-length": [
      0
    ],
    "footer-max-line-length": [
      0
    ]
  },
  "plugins": [
    {
      "rules": {
        "engineering-standards-rules": "./.config/commit-rules.json"
      }
    }
  ]
}
