{
  "name": "lightener-curve-card",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs && cp dev/fake-ha.js ../docs/fake-ha.js && npm run check:card-registration",
    "check:card-registration": "node scripts/check-card-registration.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "node --test scripts/check-card-registration.itest.mjs scripts/check-coverage-scope.itest.mjs && vitest run",
    "test:browser": "npm run build && PLAYWRIGHT_SKIP_BUILD=1 playwright test",
    "demo:capture": "node scripts/scenecast/runner.mjs scenes/lightener.scene.mjs",
    "demo:check": "node scripts/scenecast/runner.mjs scenes/lightener.scene.mjs --check",
    "demo:test": "node --test scripts/scenecast/runner.itest.mjs",
    "test:watch": "vitest",
    "test:coverage": "node --test scripts/check-card-registration.itest.mjs scripts/check-coverage-scope.itest.mjs && vitest run --coverage && node scripts/check-coverage-scope.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.0.0",
    "rollup": "^4.63.1",
    "tslib": "^2.7.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
