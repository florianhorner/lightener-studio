#!/usr/bin/env bash
# Conductor workspace setup — runs once per new workspace.
# On Debian/root, extends scripts/setup with Node.js, gh CLI, jq, and JS deps.
# On macOS/local, checks for required tools and runs scripts/setup-python.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Node baseline: .nvmrc holds the major (24); on that line jsdom 30 needs 24.15.0.
NODE_MAJOR="$(tr -d '[:space:]' < .nvmrc)"
NODE_FLOOR="24.15.0"
# Node 25 is excluded; every major from NODE_NEXT_MAJOR on is accepted.
NODE_NEXT_MAJOR="26"
# The same range as js/package.json engines.
NODE_RANGE="^${NODE_FLOOR} || >=${NODE_NEXT_MAJOR}"
node_meets_floor() {
  command -v node >/dev/null 2>&1 || return 1
  local version major
  version="$(node -p process.versions.node)"
  major="${version%%.*}"
  if [ "${major}" -ge "${NODE_NEXT_MAJOR}" ]; then
    return 0
  fi
  [ "${major}" = "${NODE_FLOOR%%.*}" ] \
    && [ "$(printf '%s\n' "${NODE_FLOOR}" "${version}" | sort -V | head -n1)" = "${NODE_FLOOR}" ]
}

install_js_deps() {
  echo "[conductor-setup] Installing JS frontend deps (js/)..."
  cd "$REPO_ROOT/js"
  if [ -f package-lock.json ]; then
    npm ci --prefer-offline --ignore-scripts
  else
    npm install --ignore-scripts
  fi
  if [ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ]; then
    chown -R "$SUDO_UID:$SUDO_GID" node_modules/ 2>/dev/null || true
  fi
  cd "$REPO_ROOT"
}

print_summary() {
  if [ -x .venv/bin/python ]; then
    _PY_VER="$(.venv/bin/python --version 2>&1)"
  else
    _PY_VER="unknown"
  fi
  _NODE_VER="$(node --version 2>/dev/null || echo 'unknown')"
  if command -v gh >/dev/null 2>&1; then
    _GH_VER="$(gh --version | head -1)"
  else
    _GH_VER="unknown"
  fi
  echo ""
  echo "  Conductor workspace ready"
  echo "  ========================"
  echo ""
  echo "  Python:  .venv/bin/python (${_PY_VER})"
  echo "  Node:    ${_NODE_VER}"
  echo "  gh CLI:  ${_GH_VER}"
  echo ""
  echo "  Activate env:    source .env.workspace"
  echo "  Fast local loop: scripts/test-fast"
  echo "  Run HA locally:  scripts/develop"
  echo "  Build JS card:   cd js && npm run build"
  echo "  Lint:            scripts/lint  (Python)"
  echo "                   cd js && npm run lint  (TS)"
  echo "  Sync to HA box:  scripts/ha-sync --frontend-only"
  echo "  Tests:           scripts/test-python"
  echo "                   cd js && npm test  (TS/vitest)"
  echo ""
}

if command -v apt-get >/dev/null 2>&1; then
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "[conductor-setup] ERROR: must run as root (e.g. sudo scripts/conductor-setup)" >&2
    exit 1
  fi

  echo "[conductor-setup] Running Debian Python/HA bootstrap..."
  bash scripts/setup

  echo "[conductor-setup] Ensuring Node.js ${NODE_RANGE} is available..."
  if ! node_meets_floor; then
    _NS_TMP=$(mktemp /tmp/nodesource-setup-XXXXXXXX.sh)
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" -o "$_NS_TMP"
    bash "$_NS_TMP"
    rm -f "$_NS_TMP"
    apt-get install -y --no-install-recommends nodejs
    if ! node_meets_floor; then
      echo "[conductor-setup] ERROR: $(command -v node) is Node $(node --version) after installing NodeSource ${NODE_MAJOR}.x, outside ${NODE_RANGE}. Another Node earlier on PATH wins, or apt kept a newer installed Node that it does not downgrade; install Node ${NODE_MAJOR} by hand." >&2
      exit 1
    fi
  fi
  echo "[conductor-setup] Node $(node --version), npm $(npm --version)"

  install_js_deps

  echo "[conductor-setup] Ensuring gh CLI is available..."
  if ! command -v gh >/dev/null 2>&1; then
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | tee /usr/share/keyrings/githubcli-archive-keyring.gpg > /dev/null
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list
    apt-get update -qq
    apt-get install -y --no-install-recommends gh
  fi
  echo "[conductor-setup] gh $(gh --version | head -1)"

  if ! command -v jq >/dev/null 2>&1; then
    apt-get update -qq
    apt-get install -y --no-install-recommends jq
  fi
else
  MISSING_TOOLS=()
  for tool in node npm gh jq; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
      MISSING_TOOLS+=("${tool}")
    fi
  done

  if [ "${#MISSING_TOOLS[@]}" -gt 0 ]; then
    echo "[conductor-setup] ERROR: missing required tools for local setup: ${MISSING_TOOLS[*]}" >&2
    echo "  Install them, then rerun scripts/conductor-setup." >&2
    exit 1
  fi

  if ! node_meets_floor; then
    echo "[conductor-setup] WARNING: Node $(node -p process.versions.node) is outside ${NODE_RANGE}." >&2
    echo "  The frontend tooling expects that range (see .nvmrc and js/package.json engines); install Node ${NODE_MAJOR}." >&2
  fi

  echo "[conductor-setup] Running local Python bootstrap..."
  bash scripts/setup-python
  echo "[conductor-setup] Node $(node --version), npm $(npm --version)"
  install_js_deps
fi

print_summary
