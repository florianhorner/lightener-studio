  "a killed run's leftover command keeps the checkout locked" --all
stop_worker "$root/orphan.pid" || exit 1
check "$root" 0 "left mutated by an interrupted run" \
  "once that command is gone, the next run recovers" --all

root="$(fixture wip-before-baseline '[{"id":"wip","file":"source.js","replace":"const flavour = \"GOOD\";","with":"const flavour = \"BAD\";","command":["./build.sh"]}]')"
# The command rewrites generated.js. Uncommitted work there must be refused
# before the baseline runs, not discovered after the build overwrote it.
printf '#!/usr/bin/env bash\ncp source.js generated.js\nhead -1 source.js | grep -q GOOD\n' > "$root/build.sh"
