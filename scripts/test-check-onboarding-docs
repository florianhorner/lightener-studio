#!/usr/bin/env python3
"""Exercise the real checker CLI against isolated, minimal guide fixtures."""

from __future__ import annotations

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CHECK = Path(__file__).with_name("check-onboarding-docs")
FILES = {
    "hacs.json": '{"homeassistant":"2024.8.0","render_readme":true}',
    "custom_components/lightener_studio/manifest.json": '{"domain":"lightener_studio"}',
    "custom_components/lightener_studio/__init__.py": 'frontend_url_path="lightener-editor"',
    "README.md": """## Installing
Requires Home Assistant 2024.8.0 or newer.
## Configure your first group
[Set up](https://my.home-assistant.io/redirect/config_flow/?domain=lightener_studio)
[Install](https://my.home-assistant.io/redirect/hacs_repository/?owner=florianhorner&repository=lightener-studio&category=integration)
## Save your first curve
Open `/lightener-editor`.
Use **Visit** on the device page or **Configure** on the integration page.
![Editor](docs/editor.png)
<img src="https://raw.githubusercontent.com/florianhorner/lightener-studio/master/docs/editor.png">
""",
    "docs/index.html": """<a href="https://github.com/florianhorner/lightener-studio#installing">Install</a>
<a href="https://github.com/florianhorner/lightener-studio#configure-your-first-group">Set up</a>
<a href="https://my.home-assistant.io/redirect/hacs_repository/?owner=florianhorner&amp;repository=lightener-studio&amp;category=integration">Open in HACS</a>
<img src="editor.png">
""",
    "docs/editor.png": "fixture image",
}


def run_case(
    name: str,
    filename: str | None = None,
    old: str = "",
    new: str = "",
    message: str = "",
) -> bool:
    with tempfile.TemporaryDirectory(prefix="onboarding-docs-") as temporary:
        root = Path(temporary)
        for relative, text in FILES.items():
            path = root / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
        (root / "scripts").mkdir()
        shutil.copyfile(CHECK, root / "scripts/check-onboarding-docs")
        if filename:
            path = root / filename
            if old not in path.read_text():
                raise AssertionError(f"{name}: fixture does not contain {old!r}")
            path.write_text(path.read_text().replace(old, new))
        result = subprocess.run(
            [sys.executable, str(root / "scripts/check-onboarding-docs")],
            capture_output=True,
            text=True,
            check=False,
        )
        output = result.stdout + result.stderr
        expected = 1 if message else 0
        passed = result.returncode == expected and (not message or message in output)
        print(f"{'ok' if passed else 'FAIL'}: {name}")
        if not passed:
            print(output)
        return passed


